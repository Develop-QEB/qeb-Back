# BI (QEBI) dentro de qeb-Back — variables de ejemplo.
# Se ponen en el .env de qeb-Back (local) o en el componente qeb-back de la app de
# DigitalOcean. TODAS llevan prefijo BI_: no chocan con las de qeb-Back.
# Una variable vacía ("BI_X=") cuenta como no definida.

# Interruptor. Sin esto (como en la app de producción) el BI no se carga en absoluto.
BI_ENABLED=true

# CORS: origen del front del BI (coma-separado). localhost/127.0.0.1, *.vercel.app y
# *.qeb.mx ya se permiten en el código.
BI_CORS_ORIGIN=https://bi.qeb.mx

# --- BD de ventas de QEB (SOLO LECTURA: V_APS_Globales, historial, etc.) ---
BI_DB_HOST=
BI_DB_USER=
BI_DB_PASSWORD=
BI_DB_NAME=
# Defaults del código: puerto 25060, SSL true (MySQL administrado de DigitalOcean).
# Para Hostinger (p. ej. la BD de PRUEBAS) usa 3306 y SSL false.
# BI_DB_PORT=25060
# BI_DB_SSL=true

# Base donde vive la tabla editable bi_presupuesto. Default: BI_DB_NAME.
# BI_WRITE_DB=
# true = el BI crea la tabla bi_presupuesto (única escritura en la BD de ventas). Default false.
BI_ALLOW_CREATE=false

# Definición de "venta real": TOTAL = todos los Monto Total | VENTA = solo U_dscTAsig='Venta'
BI_VENTA_DEF=TOTAL

# --- BD propia de QEBI (Hostinger, ESCRIBIBLE): login (qebi_usuario) + objetivos ---
# OJO: es la BD real compartida con bi.qeb.mx. Sin esto no hay login.
BI_WDB_HOST=
BI_WDB_PORT=3306
BI_WDB_USER=
BI_WDB_PASSWORD=
BI_WDB_NAME=

# Secreto de los JWT del BI. OBLIGATORIO, mínimo 32 caracteres, y DISTINTO del
# JWT_SECRET/JWT_REFRESH_SECRET de qeb-Back (si coincide, el BI no se monta). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BI_JWT_SECRET=

# Llave del endpoint temporal POST /bi/usuarios/_seed. Vacía = endpoint apagado (404).
BI_SEED_KEY=
