# Database
DATABASE_URL="mysql://user:password@host:port/database?connection_limit=10&pool_timeout=30"

# Server
PORT=3001
NODE_ENV=production

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=https://your-frontend-domain.vercel.app

# DigitalOcean Spaces (Object Storage)
SPACES_REGION=sfo3
SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
SPACES_BUCKET=your-bucket-name
SPACES_ACCESS_KEY=your-access-key-id
SPACES_SECRET_KEY=your-secret-access-key
SPACES_PUBLIC_BASE_URL=https://your-bucket-name.sfo3.digitaloceanspaces.com

# Chatbot (Qebsillo)
ANTHROPIC_API_KEY=your-anthropic-api-key

# MCP (conector para Claude / ChatGPT) — ver src/mcp/index.ts. Apagado si no se define.
# MCP_ENABLED=true
# Accesos de piloto: "<token>:<usuarioId>" separados por coma. Token de 32+ caracteres
# (generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))").
# La URL del conector de cada persona es https://<host>/mcp/<token>
# MCP_PILOT_TOKENS=
# MCP_RATE_LIMIT_PER_MIN=30
# Etiqueta del ambiente que reporta la herramienta mi_perfil (p. ej. "pruebas" o "producción").
# MCP_AMBIENTE=pruebas

# QEBooh con consultas de datos (usa las herramientas de src/mcp). Apagado si no se define.
# CHATBOT_TOOLS_ENABLED=true
# Opcional: limitar a ciertos roles durante el piloto, p. ej. "DEV,Administrador". Vacío = todos.
# CHATBOT_TOOLS_ROLES=
# Opcional: modelo para las respuestas con herramientas (por defecto, el mismo de QEBooh).
# CHATBOT_TOOLS_MODEL=
# OAuth del MCP: con esto el conector se agrega con la URL https://<host>/mcp y cada persona
# inicia sesión con su cuenta de QEB. Secreto de 32+ caracteres, DISTINTO de JWT_SECRET.
# Requiere la tabla mcp_conexiones (src/mcp/sql/mcp_conexiones.sql).
# MCP_OAUTH_SECRET=
# URL pública del back, sin "/" final. Obligatoria en ambientes fijos; con túnel puede omitirse.
# MCP_PUBLIC_URL=https://api.ejemplo.com
