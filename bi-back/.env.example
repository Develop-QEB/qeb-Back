# bi-back — variables de entorno. TODAS llevan prefijo BI_ para no chocar con las
# de qeb-Back (mismo repo y misma app de App Platform). Copia a .env para local.

# Puerto del API (en App Platform = http_port del componente, p. ej. 8080)
BI_PORT=3001

# CORS: origen del front del BI. Coma-separado para varios.
# (localhost/127.0.0.1, *.vercel.app y *.qeb.mx ya se permiten en el código)
BI_CORS_ORIGIN=http://localhost:5174

# --- BD de ventas de QEB (SOLO LECTURA: V_APS_Globales, historial, etc.) ---
BI_DB_HOST=
BI_DB_PORT=3306
BI_DB_USER=
BI_DB_PASSWORD=
BI_DB_NAME=
BI_DB_SSL=false

# Base donde vive la tabla editable bi_presupuesto (por defecto = BI_DB_NAME).
BI_WRITE_DB=
# true = el back crea la tabla bi_presupuesto (única escritura en la BD de ventas). Default false.
BI_ALLOW_CREATE=false

# Definición de "venta real": TOTAL = todos los Monto Total | VENTA = solo U_dscTAsig='Venta'
BI_VENTA_DEF=TOTAL

# --- BD propia de QEBI (Hostinger, ESCRIBIBLE): login (qebi_usuario) + objetivos ---
# OJO: es la BD real compartida con bi.qeb.mx. Sin esto no hay login.
BI_WDB_HOST=
BI_WDB_PORT=3306
BI_WDB_USER=
BI_WDB_PASSWORD=
BI_WDB_NAME=

# Secreto de los JWT del BI. OBLIGATORIO. Aleatorio (32+ caracteres) y DISTINTO del
# JWT_SECRET de qeb-Back. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BI_JWT_SECRET=

# Llave del endpoint temporal POST /usuarios/_seed. Vacía = endpoint apagado (404).
BI_SEED_KEY=
